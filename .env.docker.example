ADAPTIVEROUTE_API_HOST=0.0.0.0
ADAPTIVEROUTE_API_PORT=8090

ADAPTIVEROUTE_MEMORY_BACKEND=mongo
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=adaptiveroute
ADAPTIVEROUTE_CONTEXT_RECENT_MESSAGES=8
ADAPTIVEROUTE_CONTEXT_SUMMARY_MAX_CHARS=4000

ADAPTIVEROUTE_RAG_BACKEND=pgvector
ADAPTIVEROUTE_RAG_POSTGRES_DSN=postgresql://adaptiveroute:adaptiveroute@postgres:5432/adaptiveroute
ADAPTIVEROUTE_RAG_EMBEDDING_BACKEND=hash
ADAPTIVEROUTE_RAG_EMBEDDING_DIM=384
ADAPTIVEROUTE_RAG_CHUNK_SIZE=1200
ADAPTIVEROUTE_RAG_CHUNK_OVERLAP=160

ADAPTIVEROUTE_ORCHESTRATOR_BACKEND=rules

# Default Docker profile is intentionally lightweight and does not require model weights or GPU.
ADAPTIVEROUTE_ROUTING_POLICY_BACKEND=solver

# Map route geometry.
# fallback = straight lines between planned stops.
# osrm = road-snapped geometry from the local OSRM container. Prepare data with:
#   ./scripts/prepare_osrm_nyc.sh
# Then run:
#   ADAPTIVEROUTE_MAP_ROUTER_BACKEND=osrm ./scripts/docker_compose_cmd.sh --profile routing up -d --build
ADAPTIVEROUTE_MAP_ROUTER_BACKEND=fallback
ADAPTIVEROUTE_OSRM_BASE_URL=http://osrm:5000
ADAPTIVEROUTE_OSRM_TIMEOUT_SECONDS=8

# Optional: set these only when you want bounded optimization runs.
# ADAPTIVEROUTE_SOLVER_TIME_LIMIT_SECONDS=300
# ADAPTIVEROUTE_SOLVER_MIP_GAP=0.01
