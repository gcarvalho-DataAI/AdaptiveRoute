# AdaptiveRoute agentic runtime
#
# Copy this file to .env for local runs:
# cp .env.example .env

ADAPTIVEROUTE_API_HOST=0.0.0.0
ADAPTIVEROUTE_API_PORT=8090
ADAPTIVEROUTE_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADAPTIVEROUTE_JWT_SECRET_KEY=change-this-secret-for-non-local-runs
ADAPTIVEROUTE_JWT_EXPIRES_MINUTES=480

# memory | mongo
# Use mongo for the local UI if you plan to run async solver jobs. The API and
# planning worker are different processes, so in-memory storage is only suitable
# for synchronous smoke tests.
ADAPTIVEROUTE_MEMORY_BACKEND=mongo
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=adaptiveroute
ADAPTIVEROUTE_CONTEXT_RECENT_MESSAGES=8
ADAPTIVEROUTE_CONTEXT_SUMMARY_MAX_CHARS=4000

# RAG / documentation retrieval.
# hash works without external services; api uses an OpenAI-compatible /embeddings endpoint.
ADAPTIVEROUTE_RAG_BACKEND=memory
ADAPTIVEROUTE_RAG_POSTGRES_DSN=postgresql://adaptiveroute:adaptiveroute@127.0.0.1:5433/adaptiveroute
ADAPTIVEROUTE_RAG_EMBEDDING_BACKEND=hash
ADAPTIVEROUTE_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
ADAPTIVEROUTE_RAG_EMBEDDING_API_KEY=local
ADAPTIVEROUTE_RAG_EMBEDDING_MODEL=embed-local
ADAPTIVEROUTE_RAG_EMBEDDING_DIM=384
ADAPTIVEROUTE_RAG_CHUNK_SIZE=1200
ADAPTIVEROUTE_RAG_CHUNK_OVERLAP=160

# Orchestrator:
# - rules: deterministic rule-based event extraction, no LLM required.
# - api: OpenAI-compatible model for event extraction/reasoning.
ADAPTIVEROUTE_ORCHESTRATOR_BACKEND=rules
ADAPTIVEROUTE_ORCHESTRATOR_BASE_URL=http://127.0.0.1:8000/v1
ADAPTIVEROUTE_ORCHESTRATOR_API_KEY=local
ADAPTIVEROUTE_ORCHESTRATOR_MODEL=chat-local
ADAPTIVEROUTE_ORCHESTRATOR_TIMEOUT_SECONDS=120
ADAPTIVEROUTE_ORCHESTRATOR_TEMPERATURE=0.1

# Routing policy backend:
# - solver: deterministic Pyomo + HiGHS candidate generator.
# - api: call the trained LoRA through an OpenAI-compatible API.
# - local: load the trained LoRA adapter directly in this Python process.
ADAPTIVEROUTE_ROUTING_POLICY_BACKEND=solver

# API mode settings.
ADAPTIVEROUTE_ROUTING_POLICY_BASE_URL=http://127.0.0.1:8000/v1
ADAPTIVEROUTE_ROUTING_POLICY_API_KEY=local
ADAPTIVEROUTE_ROUTING_POLICY_MODEL=adaptiveroute-routing-policy
ADAPTIVEROUTE_ROUTING_POLICY_TIMEOUT_SECONDS=120
ADAPTIVEROUTE_ROUTING_POLICY_TEMPERATURE=0

# Local mode settings.
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_ADAPTER_PATH=models/adaptiveroute-routing-policy-lora-v5
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_MAX_NEW_TOKENS=256
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_4BIT=true
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_BF16=true

# false: lazy-load at the first candidate-generation request.
# true: load during AgenticRoutingService.from_env(...), useful to fail fast at app startup.
ADAPTIVEROUTE_ROUTING_POLICY_LOCAL_LOAD_AT_STARTUP=false
